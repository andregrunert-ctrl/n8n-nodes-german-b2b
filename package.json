{
  "name": "n8n-nodes-german-b2b",
  "version": "1.0.3",
  "description": "Official n8n community node for the German B2B Data & Compliance Suite (Handelsregister, KYB, Insolvenz, Impressum, ZUGFeRD, XRechnung, ZVG, Tenders, Leads)",
  "keywords": [
    "n8n-community-node-package",
    "germany",
    "dach",
    "handelsregister",
    "kyb",
    "insolvenz",
    "impressum",
    "zugferd",
    "xrechnung",
    "zvg",
    "tenders",
    "b2b-leads"
  ],
  "license": "MIT",
  "homepage": "https://github.com/andregrunert-ctrl/n8n-nodes-german-b2b#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andregrunert-ctrl/n8n-nodes-german-b2b.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node copy-assets.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GermanB2bApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GermanB2bSuite/GermanB2bSuite.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "n8n-workflow": "^1.36.0",
    "typescript": "^5.3.3"
  }
}
